void handleOn() {
  if (!ledOn) {
    digitalWrite(ledPin, HIGH);
    ledOn = true;
    ledStartTime = millis();
  }

  if (!buzzerOn) {
    digitalWrite(buzzerPin, HIGH);
    buzzerOn = true;
    buzzerStartTime = millis();
  }

  if (!solenoidOn) {
  digitalWrite(solenoidPin, HIGH); // Unlock (Relay ON)
  solenoidOn = true;
  solenoidStartTime = millis();
  }

  server.send(200, "text/plain", "Emergency triggered");
  Serial.println("LED, Buzzer, and Servo activated");
}

void handleOff() {
  digitalWrite(ledPin, LOW);
  digitalWrite(buzzerPin, LOW);
  digitalWrite(solenoidPin, LOW);

  ledOn = false;
  buzzerOn = false;
  solenoidOn = false;

  server.send(200, "text/plain", "Devices turned off");
  Serial.println("All devices turned OFF via /off");
}


