//================================================================
//                 START OF COMBINED SETUP
//================================================================
void setup() {
  Serial.begin(115200);
  delay(100);

  // --- Initialize Smoke Sensor Components ---
  pinMode(ledPin, OUTPUT);
  pinMode(buzzerPin, OUTPUT);
  digitalWrite(ledPin,LOW);
  digitalWrite(buzzerPin, LOW);
  
  pinMode(solenoidPin, OUTPUT);
  digitalWrite(solenoidPin, LOW); // Set relay to OFF (Locked) on boot. (Assumes Active-LOW)

  // --- Initialize OLED ---
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) { // Address 0x3C for 128x64
    Serial.println(F("SSD1306 allocation failed"));
    for(;;); // Don't proceed, loop forever
  }
  display.display();
  delay(2000); // Pause for 2 seconds
  display.clearDisplay();

  // --- Connect to WiFi (Uses function from FP project) ---
  connectToWiFi();
  Serial.print("IP Address: "); // Added from smoke sensor code
  Serial.println(WiFi.localIP());

  // --- Initialize Fingerprint Sensor ---
  finger.begin(57600);
  Serial.println("\n\nAdafruit finger detect test");

  if (finger.verifyPassword()) {
    Serial.println("Found fingerprint sensor!");
    display.clearDisplay();
    display.drawBitmap( 34, 0, FinPr_valid_bits, FinPr_valid_width, FinPr_valid_height, WHITE);
    display.display();
  } else {
    Serial.println("Did not find fingerprint sensor :(");
    display.clearDisplay();
    display.drawBitmap( 32, 0, FinPr_failed_bits, FinPr_failed_width, FinPr_failed_height, WHITE);
    display.display();
    while (1) { delay(1); }
  }
  finger.getTemplateCount();
  Serial.print("Sensor contains "); Serial.print(finger.templateCount); Serial.println(" templates");
  Serial.println("Waiting for valid finger...");

  // --- Initialize Web Server (from Smoke Sensor) ---
  server.on("/on", handleOn);
  server.on("/off", handleOff);
  server.begin();
  Serial.println("Web server started.");
}

//================================================================
//                 START OF COMBINED LOOP
//================================================================
void loop() {
  
  // --- Task 1: Handle Emergency Web Server ---
  server.handleClient();

  unsigned long current_millis = millis(); // Get time once for all checks

  // --- Task 2: Handle Emergency Timeouts ---
  // LED timeout
  if (ledOn && (current_millis - ledStartTime >= ledDuration)) {
    digitalWrite(ledPin,LOW);
    ledOn = false;
    Serial.println("LED auto turned OFF after 5 seconds");
  }
  // Buzzer timeout
  if (buzzerOn && (current_millis - buzzerStartTime >= buzzerDuration)) {
    digitalWrite(buzzerPin, LOW);
    buzzerOn = false;
    Serial.println("Buzzer auto turned OFF after 5 seconds");
  }
  
  // Solenoid timeout
  if (solenoidOn && (current_millis - solenoidStartTime >= solenoidDuration)) {
    digitalWrite(solenoidPin, LOW); // Lock the door (Relay OFF)
    solenoidOn = false;
    Serial.println("Solenoid reset (Locked) after 5 seconds");
  }

  // --- Task 3: Check WiFi (from Fingerprint) ---
  if(WiFi.status() != WL_CONNECTED){
    connectToWiFi(); // This is blocking, but necessary for the FP system
  }

  // --- Task 4: Scan for Fingerprint ---
  FingerID = getFingerprintID();
  delay(50); // Original delay from FP code
  DisplayFingerprintID();

  // --- Task 5: Check for FP Add/Delete Commands (Non-blocking) ---
  if (current_millis - last_server_check >= server_check_interval) {
    // It's been 3 seconds. Time to check the server.
    last_server_check = current_millis; // Reset the timer

    // Run the slow, blocking server checks
    ChecktoAddID();
    ChecktoDeleteID();
  }
}

